import { ToolShell, MultilineEditor, ActionButton, CopyButton, IconButton, DropdownSelector, ValueInput, InlineError, InlineNote, Theme } from "@xtools-ui/components.slint";
export component TransWindow inherits Window {
    title: "智能翻译";
    no-frame: true;
    background: Colors.transparent;
    default-font-family: "sans-serif";
    width: 540px;
    height: 580px;

    callback close-clicked();
    callback window-drag-started();
    callback window-dragged(length, length);

    in-out property <string> input-text: "";
    in-out property <string> output-text: "";
    in-out property <int> src-index: 0;
    in-out property <int> dst-index: 0;

    in property <[string]> src-options: ["自动", "中文", "英语", "日语", "韩语", "法语", "德语", "西班牙语", "俄语"];
    in property <[string]> dst-options: ["中文", "英语", "日语", "韩语", "法语", "德语", "西班牙语", "俄语"];
    in property <[string]> engine-options: ["MyMemory (免密钥)", "百度翻译"];
    in-out property <int> engine-index: 0;
    in-out property <bool> show-settings: false;
    in-out property <string> baidu-appid: "";
    in-out property <string> baidu-key: "";

    in property <bool> pending: false;
    in property <bool> can-translate: false;
    in property <bool> copied: false;
    in property <bool> can-copy: false;
    in property <string> error-text: "";
    in property <string> status-text: "引擎：MyMemory";

    callback translate-clicked();
    callback swap-clicked();
    callback copy-clicked();
    callback input-edited(string);
    callback src-changed(int);
    callback dst-changed(int);
    callback engine-changed(int);
    callback save-settings(string, string);
    callback toggle-settings();
    forward-focus: focus-scope;
    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-clicked();
                return accept;
            }
            reject
        }

        ToolShell {
            title: root.title;
            icon: "🌐";
            close-clicked => { root.close-clicked(); }
            window-drag-started => { root.window-drag-started(); }
            window-dragged(dx, dy) => { root.window-dragged(dx, dy); }

            VerticalLayout {
                spacing: 8px;
                alignment: stretch;

                // Top Bar: Section Title + Engine Selector + Settings
                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;

                    Text {
                        text: "原文 (Source)";
                        font-size: Theme.font-size-small;
                        font-weight: 600;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        Text {
                            text: "引擎：";
                            font-size: Theme.font-size-small;
                            font-weight: 500;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }

                        DropdownSelector {
                            options: root.engine-options;
                            selected-index <=> root.engine-index;
                            selector-width: 140px;
                            selection-changed(idx) => { root.engine-changed(idx); }
                        }

                        if root.engine-index == 1 : IconButton {
                            icon: "⚙";
                            clicked => { root.toggle-settings(); }
                        }
                    }
                }

                // Optional Baidu API Keys Settings Drawer
                if root.show-settings : Rectangle {
                    border-radius: Theme.radius-control;
                    border-width: 1px;
                    border-color: Theme.primary;
                    background: Theme.card-bg;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "🔑 百度翻译 API 密钥配置 (fanyi-api.baidu.com)";
                                font-size: Theme.font-size-small;
                                font-weight: 600;
                                color: Theme.foreground;
                                vertical-alignment: center;
                            }
                            IconButton {
                                icon: "×";
                                clicked => { root.toggle-settings(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: stretch;
                            ValueInput {
                                placeholder: "输入 百度翻译 App ID";
                                text <=> root.baidu-appid;
                                horizontal-stretch: 1;
                            }
                            ValueInput {
                                placeholder: "输入 密钥 (Secret Key)";
                                text <=> root.baidu-key;
                                horizontal-stretch: 1;
                            }
                            ActionButton {
                                text: "保存";
                                is-primary: true;
                                clicked => {
                                    root.save-settings(root.baidu-appid, root.baidu-key);
                                }
                            }
                        }
                    }
                }
                MultilineEditor {
                    text <=> root.input-text;
                    vertical-stretch: 1;
                    edited(t) => { root.input-edited(t); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: stretch;

                    DropdownSelector {
                        label: "源：";
                        options: root.src-options;
                        selected-index <=> root.src-index;
                        selector-width: 112px;
                        selection-changed(idx) => { root.src-changed(idx); }
                    }

                    IconButton {
                        icon: "⇄";
                        clicked => { root.swap-clicked(); }
                    }

                    DropdownSelector {
                        label: "目标：";
                        options: root.dst-options;
                        selected-index <=> root.dst-index;
                        selector-width: 112px;
                        selection-changed(idx) => { root.dst-changed(idx); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        text: root.pending ? "翻译中…" : "🚀 翻译";
                        is-primary: true;
                        enabled: !root.pending && root.can-translate;
                        clicked => { root.translate-clicked(); }
                    }
                }

                Text {
                    text: "译文 (Translation)";
                    font-size: Theme.font-size-small;
                    font-weight: 600;
                    color: Theme.muted;
                }

                MultilineEditor {
                    text <=> root.output-text;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: stretch;

                    if root.error-text != "" : InlineError {
                        error-text: root.error-text;
                        horizontal-stretch: 1;
                    }

                    if root.error-text == "" : InlineNote {
                        text: root.pending ? "正在翻译…" : root.status-text;
                        horizontal-stretch: 1;
                    }

                    CopyButton {
                        copied: root.copied;
                        enabled: root.can-copy;
                        clicked => { root.copy-clicked(); }
                    }
                }
            }
        }
    }
}
