export global Theme {
    // Surfaces & Canvas
    out property <color> background: #F8FAFC;
    out property <color> card-bg: #FFFFFF;
    out property <color> foreground: #0F172A;
    out property <color> secondary: #F1F5F9;
    out property <color> secondary-hover: #E2E8F0;
    out property <color> secondary-active: #CBD5E1;
    out property <color> muted: #64748B;
    out property <color> border: #E2E8F0;
    out property <color> border-subtle: #F1F5F9;
    out property <color> border-hover: #CBD5E1;

    // Brand & Primary Accents
    out property <color> primary: #2563EB;
    out property <color> primary-hover: #1D4ED8;
    out property <color> primary-active: #1E40AF;
    out property <color> primary-fg: #FFFFFF;
    out property <color> primary-glow: #2563EB26;
    out property <color> selection: #BFDBFE;

    // Success / Copied
    out property <color> success: #059669;
    out property <color> success-hover: #047857;
    out property <color> success-bg: #ECFDF5;
    out property <color> success-border: #A7F3D0;

    // Errors & Warnings
    out property <color> error-fg: #DC2626;
    out property <color> error-bg: #FEF2F2;
    out property <color> error-border: #FECACA;

    // Typography
    out property <length> font-size-title: 15px;
    out property <length> font-size-body: 14px;
    out property <length> font-size-small: 12px;
    out property <string> font-mono: "monospace";

    // Geometry & Metrics
    out property <length> radius-card: 8px;
    out property <length> radius-control: 8px;
    out property <length> radius-pill: 8px;
    out property <length> control-height: 32px;
    out property <length> titlebar-height: 42px;
}
